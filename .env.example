# Copy to .env and replace the placeholders. Never commit .env.
MARIADB_ROOT_PASSWORD=change-me
MARIADB_DATABASE=hoteldb
MARIADB_USER=hoteluser
MARIADB_PASSWORD=change-me

# Start accounts, created at the first start if the name does not exist yet (password: at least 8 characters)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me
APP_RECEPTION_USERNAME=reception
APP_RECEPTION_PASSWORD=change-me
